<launch>
  <!--
    racing_stack.launch
    ===================
    Starts the autonomous racing stack.

    Prerequisites: laser_bringup.launch AND localization_amcl.launch
    must already be running.

    ROSMASTER R2 driver interface (Mcnamu_driver.py):
      Subscribes to /cmd_vel (geometry_msgs/Twist):
        msg.linear.x  = forward speed (m/s)
        msg.linear.y  = steering angle (radians, +left/-right)  ← NOT angular.z
        msg.angular.z = passed to firmware but largely unused

    The joystick (yahboom_joy.py) already outputs linear.y natively.
    Pure pursuit outputs standard angular.z — twist_to_rosmaster converts
    it to linear.y BEFORE twist_mux so both sources are in the same format.

    Command flow:
      Joystick       → /cmd_vel_teleop  (linear.y, already correct)         ─┐
      pure_pursuit   → /cmd_vel_auto_raw (angular.z)                          │
        → cmdvel_gate (LB deadman)  → /cmd_vel_auto                           │
          → steering_modifier+FTG   → /cmd_vel_safety (angular.z)             │
            → twist_to_rosmaster    → /cmd_vel_auto_rm (linear.y converted)  ─┤
                                  twist_mux (teleop=90 > auto=50)              │
                                       → /cmd_vel → hardware driver ◄──────────┘

    Usage:
      roslaunch r2_tg30_race racing_stack.launch
      roslaunch r2_tg30_race racing_stack.launch \
          waypoint_yaml:=$(rospack find r2_tg30_race)/waypoints/waypoints_closed.yaml
  -->

  <arg name="waypoint_yaml"
       default="$(find r2_tg30_race)/waypoints/waypoints.yaml"/>

  <!-- Waypoint publisher → /race_path (yellow line) + /race_waypoints (green spheres) -->
  <node pkg="r2_tg30_race" type="waypoint_map_builder.py"
        name="waypoint_map_builder" output="screen">
    <param name="yaml_file"  value="$(arg waypoint_yaml)"/>
    <param name="path_topic" value="/race_path"/>
  </node>

  <!-- Pure pursuit: TF map→base_link + /race_path → /cmd_vel_auto_raw (angular.z) -->
  <node pkg="r2_tg30_race" type="pure_pursuit_twist.py"
        name="pure_pursuit_twist" output="screen">
    <rosparam command="load"
              file="$(find r2_tg30_race)/config/pure_pursuit.yaml"/>
  </node>

  <!-- Follow the Gap: /scan_obstacles → /cmd_vel_ftg_raw (angular.z) -->
  <node pkg="r2_tg30_race" type="follow_the_gap.py"
        name="follow_the_gap" output="screen">
    <rosparam command="load"
              file="$(find r2_tg30_race)/config/follow_the_gap.yaml"/>
  </node>

  <!-- LB deadman button → /auto_enable (Bool) -->
  <node pkg="r2_tg30_race" type="joy_deadman.py"
        name="joy_deadman" output="screen">
    <rosparam command="load"
              file="$(find r2_tg30_race)/config/joystick_deadman.yaml"/>
  </node>

  <!-- Gate: passes /cmd_vel_auto_raw → /cmd_vel_auto only when LB held -->
  <node pkg="r2_tg30_race" type="cmdvel_gate.py"
        name="cmdvel_gate" output="screen">
    <rosparam command="load"
              file="$(find r2_tg30_race)/config/deadman_gate.yaml"/>
  </node>

  <!-- Blend PP + FTG by obstacle distance → /cmd_vel_safety (angular.z) -->
  <node pkg="r2_tg30_race" type="steering_modifier.py"
        name="steering_modifier" output="screen">
    <rosparam command="load"
              file="$(find r2_tg30_race)/config/steering_modifier.yaml"/>
  </node>

  <!-- Convert angular.z → linear.y for ROSMASTER R2 driver.
       Only the autonomous path needs this — joystick already uses linear.y. -->
  <node pkg="r2_tg30_race" type="twist_to_rosmaster.py"
        name="twist_to_rosmaster" output="screen">
    <param name="in_topic"      value="/cmd_vel_safety"/>
    <param name="out_topic"     value="/cmd_vel_auto_rm"/>
    <param name="wheelbase_m"   value="0.26"/>
    <param name="max_steer_rad" value="0.45"/>
  </node>

  <!-- twist_mux: joystick (90) overrides auto (50) → /cmd_vel → driver -->
  <node pkg="twist_mux" type="twist_mux" name="twist_mux" output="screen">
    <rosparam file="$(find r2_tg30_race)/config/twist_mux.yaml"
              command="load"/>
    <remap from="cmd_vel_out" to="/cmd_vel"/>
  </node>

  <!-- Mode indicator: "AUTO" or "MANUAL" string for RViz -->
  <node pkg="r2_tg30_race" type="mode_indicator.py"
        name="mode_indicator" output="screen"/>

</launch>
