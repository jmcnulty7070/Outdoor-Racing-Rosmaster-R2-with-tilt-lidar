<launch>
  <!--
    localization_amcl.launch
    ========================
    Loads a saved map and starts AMCL particle filter localization.

    Prerequisites: laser_bringup.launch must already be running.

    Usage:
      roslaunch r2_tg30_race localization_amcl.launch
      roslaunch r2_tg30_race localization_amcl.launch map_file:=/path/to/map.yaml
  -->
  <arg name="map_file"
       default="$(find r2_tg30_race)/maps/driveway_course.yaml"/>

  <!-- Load the map -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)"/>

  <!-- AMCL localization.
       Uses /scan_obstacles (curb/grass-aware scan, already running from laser_bringup).
       Gets motion model from /odom (EKF-fused wheel+IMU, from laser_bringup).
       Publishes map → odom TF so the whole TF chain closes. -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan_obstacles"/>

    <param name="odom_frame_id"   value="odom"/>
    <param name="base_frame_id"   value="base_footprint"/>
    <param name="global_frame_id" value="map"/>

    <param name="odom_model_type" value="diff-corrected"/>

    <param name="min_particles"   value="500"/>
    <param name="max_particles"   value="3000"/>

    <param name="update_min_d"    value="0.08"/>
    <param name="update_min_a"    value="0.08"/>

    <param name="laser_z_hit"     value="0.90"/>
    <param name="laser_z_rand"    value="0.05"/>
    <param name="laser_z_max"     value="0.05"/>
    <param name="laser_max_beams" value="90"/>
    <param name="laser_max_range" value="12.0"/>
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.10"/>

    <param name="transform_tolerance" value="0.20"/>
    <param name="resample_interval"   value="1"/>
  </node>
</launch>
