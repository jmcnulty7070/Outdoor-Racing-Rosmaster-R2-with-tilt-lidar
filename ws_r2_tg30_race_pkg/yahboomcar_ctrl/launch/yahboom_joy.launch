<launch>
  <!--
    yahboom_joy.launch  –  Joystick teleop (ROS Melodic)
    =====================================================
    Joystick  →  /joy  →  yahboom_joy.py  →  /cmd_vel_teleop
    twist_mux gives teleop priority 90 (auto=50, safety=100).
    Moving the left stick always overrides autonomous driving.

    Gamepad layout (Yahboom controller in "jetson" mode):
      Left  stick up/down  = forward / reverse
      Left  stick left/right = not used (Ackermann – steer via right stick)
      Right stick left/right = steering
      LB (button 6)  = deadman for autonomous mode
      R2 (axes[4]=-1) = cancel navigation goal
  -->
  <param name="use_sim_time" value="false"/>

  <node name="joy_node" pkg="joy" type="joy_node" output="screen" respawn="true">
    <param name="dev"             value="/dev/input/js0"/>
    <param name="deadzone"        value="0.05"/>
    <param name="autorepeat_rate" value="20.0"/>
  </node>

  <node name="yahboom_joy" pkg="yahboomcar_ctrl" type="yahboom_joy.py"
        output="screen" respawn="true">
    <param name="linear_speed_limit"  type="double" value="1.0"/>
    <param name="angular_speed_limit" type="double" value="5.0"/>
    <!-- Feed into twist_mux teleop slot, not the driver directly -->
    <remap from="cmd_vel" to="/cmd_vel_teleop"/>
  </node>
</launch>
