<launch>
  <!--
    laser_bringup.launch  –  ROSMASTER R2 + TG30 LiDAR  (ROS Melodic / Ubuntu 18.04)
    ===================================================================================
    This is the ONE launch file to bring up the car and LiDAR together.
    Run this FIRST in every session before mapping, localization, or racing.

    What it starts:
      1. TG30 YDLidar driver       → /scan  (raw laser data)
      2. Hardware driver            → wheels, motor control
      3. IMU filter (Madgwick)      → /imu/imu_data  (smoothed orientation)
      4. EKF (wheel odom + IMU)     → /odom  (fused position estimate)
      5. URDF / TF publishers       → robot_description, joint_states
      6. Joystick teleop            → /cmd_vel_teleop  (you can drive immediately)
      7. Scan cleanup pipeline      → /scan_filtered → /scan_cloud → /scan_obstacles
                                      (curb/grass edges included)

    NOTE: The TF for laser_link comes from the URDF (yahboomcar_R2.urdf.xacro).
    The URDF sets pitch = -0.08726646 rad (-5 degrees downward) which is correct
    for the TG30 mounting. No static_transform_publisher for the laser is needed
    — and the old one that was here (wrong height/no tilt) has been removed.

    Usage:
      export ROBOT_TYPE=R2
      roslaunch yahboomcar_nav laser_bringup.launch

    Optional args:
      use_ekf:=true       (default) fuse IMU + wheel odom
      use_rviz:=false     (default) open odom RViz window
  -->

  <arg name="use_ekf"  default="true"/>
  <arg name="use_rviz" default="false"/>
  <!-- ROBOT_TYPE must be set in environment: export ROBOT_TYPE=R2 -->
  <arg name="robot_type" value="$(env ROBOT_TYPE)"
       doc="robot_type [X1,X3,X3plus,R2,X7]"/>

  <!-- ── 1+2+3+4+5+6: hardware driver, IMU, EKF, URDF, joystick ── -->
  <include file="$(find yahboomcar_bringup)/launch/bringup.launch">
    <arg name="use_ekf"  value="$(arg use_ekf)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>

  <!-- ── 1: TG30 YDLidar driver ──
       Publishes /scan in the laser_link frame.
       The URDF defines laser_link at xyz="0.01601 0 0.1649"
       rpy="0 -0.08726646 3.14159265" (5 degrees downward, facing forward).
       No extra static_transform_publisher needed. -->
  <node pkg="ydlidar_ros_driver" type="ydlidar_ros_driver_node"
        name="ydlidar_ros_driver" output="screen">
    <param name="port"     value="/dev/ydlidar"/>
    <param name="baudrate" value="230400"/>
    <param name="frame_id" value="laser_link"/>
    <param name="lidar_type"      value="1"/>
    <param name="device_type"     value="0"/>
    <param name="sample_rate"     value="5"/>
    <param name="abnormal_check_count" value="4"/>
    <param name="fixed_resolution" value="true"/>
    <param name="reversion"       value="false"/>
    <param name="inverted"        value="false"/>
    <param name="auto_reconnect"  value="true"/>
    <param name="isSingleChannel" value="false"/>
    <param name="intensity"       value="false"/>
    <param name="support_motor_dtr" value="false"/>
    <param name="angle_min"       value="-180"/>
    <param name="angle_max"       value="180"/>
    <param name="range_min"       value="0.12"/>
    <param name="range_max"       value="12.0"/>
    <param name="frequency"       value="7.0"/>
    <remap from="/scan" to="/scan"/>
  </node>

  <!-- ── 7: Scan cleanup pipeline ──
       Converts raw /scan → /scan_filtered → /scan_cloud → /scan_obstacles
       /scan_obstacles includes curb faces and grass edges (height 2.5–28 cm).
       Used by Cartographer, AMCL, FTG, and pure pursuit. -->
  <include file="$(find r2_tg30_race)/launch/scan_cleanup.launch">
    <arg name="scan_in"        value="/scan"/>
    <arg name="scan_obstacles" value="/scan_obstacles"/>
  </include>

</launch>
