<launch>
  <!-- AMCL localization launch.
       IMU note: AMCL itself is a laser-only localiser and does not consume IMU
       directly. However, the EKF in bringup.launch fuses IMU + wheel odom into
       /odom, which AMCL uses as its motion model. Run bringup.launch FIRST so
       the EKF-smoothed /odom is available before starting this launch. -->
  <arg name="map_file"            default="$(find r2_tg30_race)/maps/driveway_course.yaml"/>
  <arg name="start_driver"        default="false"/>
  <arg name="scan_topic"          default="/scan"/>
  <arg name="obstacle_scan_topic" default="/scan_obstacles"/>

  <include file="$(find r2_tg30_race)/launch/tg30_bringup.launch">
    <arg name="start_driver" value="$(arg start_driver)"/>
    <arg name="scan_topic"   value="$(arg scan_topic)"/>
  </include>

  <include file="$(find r2_tg30_race)/launch/scan_cleanup.launch">
    <arg name="scan_in"        value="$(arg scan_topic)"/>
    <arg name="scan_obstacles" value="$(arg obstacle_scan_topic)"/>
  </include>

  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)"/>

  <!-- AMCL: uses /scan_obstacles (curb/grass aware derived scan).
       base_frame_id must match the URDF – use base_footprint for EKF compat. -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="$(arg obstacle_scan_topic)"/>

    <param name="odom_frame_id"    value="odom"/>
    <param name="base_frame_id"    value="base_footprint"/>  <!-- matches EKF world frame -->
    <param name="global_frame_id"  value="map"/>

    <!-- Ackermann/differential motion model (use diff for R2 Ackermann) -->
    <param name="odom_model_type"  value="diff-corrected"/>

    <!-- Particle count: more particles help on outdoor scenes with sparse features -->
    <param name="min_particles"    value="500"/>
    <param name="max_particles"    value="3000"/>

    <!-- Update thresholds -->
    <param name="update_min_d"     value="0.08"/>   <!-- m moved before update -->
    <param name="update_min_a"     value="0.08"/>   <!-- rad turned before update -->

    <!-- Laser model tuned for outdoor curb/grass returns -->
    <param name="laser_z_hit"      value="0.90"/>
    <param name="laser_z_rand"     value="0.05"/>
    <param name="laser_z_max"      value="0.05"/>
    <param name="laser_max_beams"  value="90"/>
    <param name="laser_max_range"  value="12.0"/>
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <!-- Recovery: allow fast particle re-injection if lost -->
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.10"/>

    <param name="transform_tolerance" value="0.20"/>
    <param name="resample_interval"   value="1"/>
  </node>
</launch>
