Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
    Tree Height: 680
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Alpha: 0.10
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.50
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 160; 160; 164
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Raw Scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (Pixels): 2
      Size (m): 0.03
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Alpha: 0.95
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 55; 255; 110
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Grass and Edge Scan (obstacles)
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.05
      Style: Flat Squares
      Topic: /scan_obstacles
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.30
      Name: TF
      Show Arrows: true
      Show Axes: false
      Show Names: false
      Update Interval: 0
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 210; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Race Path
      Offset: {X: 0, Y: 0, Z: 0.03}
      Pose Style: None
      Topic: /race_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /race_waypoints
      Name: Waypoints
      Queue Size: 10
      Value: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 40
      Target Frame: base_link
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd0000000400000000000001400000027afc0200000003fb0000001200530065006c0065006300740069006f006e00000001e10000009b0000005c00fffffffb0000000a0056006900650077007300000000000000027a000000a400fffffffb0000001200530065006c0065006300740069006f006e0000000000ffffffff0000000000000000
  Views:
    collapsed: false
  Time:
    collapsed: false
  Width: 1280
  X: 0
  Y: 27
