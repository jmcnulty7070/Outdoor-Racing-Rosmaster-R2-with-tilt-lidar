Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
    Tree Height: 680
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Alpha: 0.10
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.70
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.95
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 55; 255; 110
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Obstacle Scan (grass/curb)
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.05
      Style: Flat Squares
      Topic: /scan_obstacles
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Axes Length: 0.30
      Axes Radius: 0.02
      Class: rviz/PoseWithCovariance
      Color: 255; 64; 64
      Enabled: true
      Head Length: 0.10
      Head Radius: 0.04
      Name: AMCL Pose
      Shape: Arrow
      Topic: /amcl_pose
      Unreliable: false
      Value: true
    - Alpha: 0.60
      Arrow Length: 0.15
      Class: rviz/PoseArray
      Color: 239; 100; 100
      Enabled: true
      Name: AMCL Particles
      Shape: Arrow (Flat)
      Topic: /particlecloud
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 210; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.10
      Name: Race Path
      Offset: {X: 0, Y: 0, Z: 0.03}
      Pose Style: None
      Topic: /race_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /race_waypoints
      Name: Waypoints
      Queue Size: 10
      Value: true
    - Class: rviz/PointStamped
      Color: 255; 170; 0
      Enabled: true
      History Length: 1
      Name: Lookahead Point (PP)
      Radius: 0.14
      Topic: /pure_pursuit/lookahead_point
      Unreliable: false
      Value: true
    - Class: rviz/String
      Enabled: true
      Name: Driving Mode
      Topic: /driving_mode
      Value: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X Std Dev: 0.25
      Y Std Dev: 0.25
      Theta Std Dev: 0.35
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 40
      Target Frame: base_link
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd0000000400000000000001400000027afc0200000003fb0000001200530065006c0065006300740069006f006e00000001e10000009b0000005c00fffffffb0000000a0056006900650077007300000000000000027a000000a400fffffffb0000001200530065006c0065006300740069006f006e0000000000ffffffff0000000000000000
  Views:
    collapsed: false
  Time:
    collapsed: false
  Width: 1280
  X: 0
  Y: 27
